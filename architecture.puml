@startuml
!theme vibrant
skinparam backgroundColor #0b0f19
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontColor #e2e8f0
skinparam ArrowColor #00f0ff
skinparam BoxPadding 10
skinparam ParticipantPadding 10

title "Unmute - Real-Time AI Sign Language Translator - System Architecture"

package "Frontend Web Application (Browser Client)" {
    [Live Camera Module] as CamMod #1e293b
    [Video Upload Module] as UploadMod #1e293b
    [Canvas Skeleton HUD] as CanvasHUD #0f172a
    [Sign Visualizer Engine] as VisualizerEng #047857
    [Sentence Composer & Buffer] as SentenceComp #1e293b
    [Text-to-Speech Engine] as TTSEngine #1e293b
    [Practice Studio] as PracticeMod #1e293b
    [Custom Gesture Studio] as CustomMod #1e293b
    [ASL & ISL Dictionary Guide] as DictMod #1e293b
    [Sign Language Mode Selector (ASL/ISL)] as LangSelector #047857
    [Theme Manager (Light/Dark)] as ThemeMod #1e293b
    database "Browser LocalStorage" as BrowserStore #0f172a
}

package "FastAPI Backend Layer" {
    [FastAPI Application (main.py)] as AppMain #1e293b
    [System Health API (/api/status)] as RESTStatus #0f172a
    [WebSocket Live Feed (/ws/live-stream)] as WSFeed #0f172a
    [REST Frame API (/api/predict-frame)] as RESTFrame #0f172a
    [Video Upload Handler (/api/upload-video)] as RESTUpload #0f172a
    [Video Status & Result Endpoints] as RESTVideoRes #0f172a
    [Video File Stream (/api/video-file)] as RESTVideoStream #0f172a
    [Subtitle Exporter (.srt / .vtt / .json)] as SubExporter #0f172a
    [Custom Gesture Storage API] as CustomAPI #0f172a
    [Dictionary API (/api/dictionary)] as DictAPI #0f172a
}

package "Sign Recognition Core Engine" {
    [MediaPipe Hand Landmarker (1 or 2 Hands)] as MPExtractor #334155
    [Dual-Hand Feature Engineer (109-dim ASL / 228-dim ISL)] as FeatEng #334155
    [Heuristic ASL/ISL Classifier (Rules)] as ASLClass #047857
    [Dynamic Temporal Gesture Tracker] as TempTracker #047857
    [Dynamic Sequence Recognition (LSTM)] as DynamicLSTM #047857
    [Stability & Jitter Filter] as StabFilter #334155
    [Custom Gesture Trainer (KNN ML)] as CustTrainer #334155
    [Video File Processing Pipeline] as VidProc #334155
}

package "Language & NLP Processing Layer (nlp/)" {
    [Structured Token Sequence Buffer] as TokenBuffer #1e293b
    [Rule-Based Sentence Processor & Grammar Engine] as SentenceProc #1e293b
}

package "Machine Learning Foundation (ml/)" {
    [Legacy Model Audit & Comparative Benchmark] as MLAudit #1e293b
    [Dual Dataset Pipeline (ASL 109-dim & ISL 228-dim)] as MLData #1e293b
    [Static ASL Recognition MLP (PyTorch)] as MLModelASL #047857
    [Static ISL Recognition MLP (PyTorch)] as MLModelISL #047857
    [Dynamic Sign Sequence LSTM (PyTorch)] as MLModelLSTM #047857
}

database "Server Storage & Assets" {
    folder "Uploads / Processed Videos" as StorageUploads #475569
    folder "Custom Gesture Datasets" as StorageCustom #475569
    folder "Trained Models (ASL/ISL .pt & RF Baseline)" as StorageModels #475569
    folder "Static Web Assets (HTML/CSS/JS)" as StorageStatic #475569
}

' Frontend Interactions
CamMod --> CanvasHUD : Draws Video & Overlays
CamMod --> WSFeed : Streams Video Frames & Active Mode
LangSelector --> WSFeed : Transmits Selected Language ("ASL" | "ISL")
LangSelector --> BrowserStore : Persists Language Preference

UploadMod --> RESTUpload : Video File (MP4, WebM, MOV, AVI)
UploadMod --> RESTVideoRes : Polls Processing Status & Result
UploadMod --> RESTVideoStream : Streams Processed Video
UploadMod --> SubExporter : Downloads Transcripts

PracticeMod --> RESTFrame : Evaluates User Hand Pose
PracticeMod --> VisualizerEng : Renders Target Reference Handshape

CustomMod --> CustomAPI : Records Sample Vectors
DictMod --> DictAPI : Fetches ASL & ISL Guides
DictMod --> VisualizerEng : Renders Mini Card Skeletons & Modal Inspector

ThemeMod --> BrowserStore : Saves/Loads UI Theme

' Backend to Engine Interactions
WSFeed --> MPExtractor : Binary / Frame Bytes
RESTFrame --> MPExtractor : Frame Image Data

RESTUpload --> StorageUploads : Saves File
RESTUpload --> VidProc : Starts Asynchronous Processing
RESTVideoStream --> StorageUploads : Reads File

CustomAPI --> CustTrainer : Calibrates Custom Model
CustTrainer --> StorageCustom : Saves Gesture Weights

AppMain --> StorageStatic : Serves Frontend

' Engine Internal Flow
VidProc --> MPExtractor : Frame-by-Frame Tracking
VidProc --> FeatEng : 21 or 42 3D Coordinates & Handedness
VidProc --> ASLClass : Frame Classification
VidProc --> TempTracker : Motion Gestures
VidProc --> SubExporter : Generates Timestamped Transcripts

MPExtractor --> FeatEng : 21 or 42 3D Coordinates & Handedness
FeatEng --> ASLClass : 109-dim (ASL) / 228-dim (ISL) Features
FeatEng --> TempTracker : Sliding-Window Trajectory
FeatEng --> DynamicLSTM : Landmark Sequences
FeatEng --> CustTrainer : Predicts Custom Gestures
ASLClass --> StabFilter : Frame Predictions & Confidence
TempTracker --> StabFilter : Dynamic Gesture Triggers
DynamicLSTM --> StabFilter : Sequence Predictions

' Engine to NLP & Backend Output
StabFilter --> TokenBuffer : Emits Structured Token(text, conf, type, lang)
TokenBuffer --> SentenceProc : Sequence of Validated Tokens
SentenceProc --> WSFeed : Refined Sentence Translation
StabFilter --> RESTFrame : Prediction Result

' Backend to Frontend Output
WSFeed --> SentenceComp : Real-Time Letter / Word / Sentence Tokens
SentenceComp --> TTSEngine : Synthesized Speech Audio
SentenceComp --> CamMod : Live Subtitles & Suggestions

' Machine Learning Foundation Flow
FeatEng --> MLAudit : 109-Dim Features (ASL Baseline)
StorageModels ..> MLAudit : Loads asl_rf_model.joblib
FeatEng --> MLModelASL : 109-Dim Invariant Features (ASL)
FeatEng --> MLModelISL : 228-Dim Bimanual Features (ISL)
FeatEng --> MLModelLSTM : Multi-Frame Sequences (ASL/ISL)
MLData --> MLModelASL : Preprocessed ASL Batches (.npz)
MLData --> MLModelISL : Preprocessed ISL Batches (.npz)
MLModelASL ..> StorageModels : Saves asl_static_mlp.pt
MLModelISL ..> StorageModels : Saves isl_static_mlp.pt
MLModelLSTM ..> StorageModels : Saves dynamic_lstm.pt

@enduml
