@startuml Unmute_Architecture
title "UNMUTE - Real-Time AI Sign Language Translator - System Architecture"
skinparam componentStyle rectangle

' ==========================================================
' Frontend Client Layer (Browser Client)
' ==========================================================
package "Frontend Web Application (Browser Client)" {
  component "Live Camera Controller (app.js)" as CamMod <<Controller>>
  component "Canvas Skeleton HUD Overlay" as CanvasHUD <<Overlay>>
  component "Sign Language Mode Switcher (ASL/ISL)" as LangSelector <<Component>>
  component "Video Upload & Subtitle Player" as UploadMod <<Component>>
  component "Interactive Practice Studio" as PracticeMod <<Component>>
  component "Sign Visualizer & Skeleton Guide" as VisualizerEng <<Engine>>
  component "Custom Gesture Studio" as CustomMod <<Component>>
  component "Bilingual Visual Dictionary (ASL/ISL)" as DictMod <<Component>>
  component "Sentence Composer & Accumulator" as SentenceComp <<Component>>
  component "Browser Text-to-Speech (Web Speech API)" as TTSEngine <<Service>>
  component "Theme Manager (Light/Dark)" as ThemeMod <<Component>>
  database "Browser LocalStorage" as BrowserStore <<Storage>>
}

' ==========================================================
' Backend Layer (FastAPI Core)
' ==========================================================
package "FastAPI Backend Layer (backend/main.py)" {
  component "FastAPI Main Application" as AppMain <<Server>>
  component "System Health API (/api/status)" as RESTStatus <<Controller>>
  component "Real-Time WebSocket Feed (/ws/live-stream)" as WSFeed <<WebSocket>>
  component "Single-Frame Predict API (/api/predict-frame)" as RESTFrame <<Controller>>
  component "Video Upload API (/api/upload-video)" as RESTUpload <<Controller>>
  component "Video Status & Result APIs (/api/video-*)" as RESTVideoRes <<Controller>>
  component "Video Stream Server (/api/video-file/{id})" as RESTVideoStream <<Controller>>
  component "Subtitle Exporter (/api/export-subtitles)" as SubExporter <<Utility>>
  component "Dictionary Guide API (/api/dictionary)" as DictAPI <<Controller>>
  component "Custom Gesture API (/api/custom-gesture/*)" as CustomAPI <<Controller>>
}

' ==========================================================
' Sign Recognition Core Engine
' ==========================================================
package "Sign Recognition Core Engine (sign_engine/)" {
  component "MediaPipe Hands Landmarker (1 or 2 Hands)" as MPExtractor <<Pipeline>>
  component "Dual-Hand Feature Engineer (feature_engineering.py)" as FeatEng <<Engine>>
  note bottom of FeatEng
    Feature Dimensions:
    - ASL: 109-dim Invariant Vector
    - ISL: 228-dim Bimanual Vector
      (109 Primary + 109 Secondary + 10 Inter-hand metrics)
  end note

  component "Hybrid Static Classifier (asl_classifier.py)" as ASLClass <<Classifier>>
  note bottom of ASLClass
    Static Engine:
    - Anatomical Rule Heuristics
    - 3-Frame Stability Deque
    - Legacy RF Baseline Fallback
  end note

  component "Dynamic Temporal Gesture Tracker (temporal_tracker.py)" as TempTracker <<Tracker>>
  note bottom of TempTracker
    Temporal Tracker:
    - 36-Frame Rolling Window
    - Trajectory & Velocity Heuristics
    - 0.9s Cooldown Debounce
  end note

  component "Dynamic Sequence Recognition (PyTorch LSTM)" as DynamicLSTM <<Classifier>>
  component "Stability & Jitter Filter" as StabFilter <<Filter>>
  component "Custom Gesture Trainer (KNN ML, k=3)" as CustTrainer <<Trainer>>
  component "Asynchronous Video Processor (video_processor.py)" as VidProc <<Worker>>
}

' ==========================================================
' Language & NLP Processing Layer
' ==========================================================
package "Language & NLP Processing Layer (nlp/)" {
  component "Structured Token Interface" as TokenContract <<Contract>>
  note bottom of TokenContract
    Token Schema:
    Token(text, conf, type, lang, ts)
  end note

  component "Sequence Buffer Queue" as TokenBuffer <<Buffer>>
  component "Rule-Based Sentence Processor & Grammar Engine" as SentenceProc <<Processor>>
  note bottom of SentenceProc
    Grammar Pipeline:
    - ASL / ISL Transformations
    - Pronoun & Verb Conjugation
    - Punctuation & Capitalization
  end note
}

' ==========================================================
' Machine Learning Foundation
' ==========================================================
package "Machine Learning Foundation (ml/)" {
  component "Authoritative Label Mappings (ml/data/labels.py)" as MLLabels <<Module>>
  note bottom of MLLabels
    Controlled Vocabularies:
    - ASL: 41 Classes (24 Alpha, 10 Num, 6 Phrase, 1 Space)
    - ISL: 44 Classes (26 Alpha, 10 Num, 7 Phrase, 1 Space)
  end note

  component "Legacy Model Audit Suite (ml/legacy_rf_audit.py)" as MLAudit <<Benchmark>>
  component "Data Preparation Pipeline (ml/data/prepare_dataset.py)" as MLPrep <<Pipeline>>
  component "PyTorch Dataset & DataLoader Abstractions (ml/data/dataset.py)" as MLDataset <<Dataset>>
  component "Static ASL Recognition MLP (ml/models/static_mlp.py)" as MLModelASL <<Model>>
  component "Static ISL Recognition MLP (ml/models/static_mlp.py)" as MLModelISL <<Model>>
  component "Dynamic Sign Sequence LSTM (PyTorch)" as MLModelLSTM <<Model>>
  component "Training, Validation & Evaluation Suite (ml/training/)" as MLTrainEval <<Engine>>
}

' ==========================================================
' Database & File Storage Layer
' ==========================================================
package "File Storage & Project Assets" {
  folder "Trained Model Weights (models/)" as StorageModels {
    [asl_rf_model.joblib (Legacy RF)]
    [asl_static_mlp.pt (Trained ASL MLP)]
    [isl_static_mlp.pt (Trained ISL MLP)]
    [dynamic_lstm.pt (Trained LSTM)]
  }

  folder "Preprocessed Feature Datasets (data/)" as StorageData {
    [asl_train.npz, asl_val.npz, asl_test.npz]
    [isl_train.npz, isl_val.npz, isl_test.npz]
    [asl_manifest.json, isl_manifest.json]
  }

  folder "Uploaded & Processed Videos (uploads/)" as StorageUploads {
    [Uploaded Video Files]
    [Keyframe Caches]
    [Generated Subtitle Transcripts (.srt, .vtt, .json)]
  }

  folder "Custom Gestures" as StorageCustom {
    [custom_gestures.json]
  }

  folder "Client Static Web Assets (static/)" as StorageStatic {
    [index.html]
    [app.js]
    [styles.css]
  }
}

' ==========================================================
' Flow & Relationships
' ==========================================================
' Frontend Client Flow
CamMod -[#111111]-> CanvasHUD : Draws Video Feed & Glowing HUD
CamMod -[#0052cc]-> WSFeed : Streams JPEG Frames & Active Mode ({image, language})
LangSelector -[#0052cc]-> WSFeed : Transmits Active Sign Language ("ASL" | "ISL")
LangSelector -[#ff991f]-> BrowserStore : Persists User Language Preference
ThemeMod -[#ff991f]-> BrowserStore : Saves/Loads UI Theme Preference

UploadMod -[#0052cc]-> RESTUpload : Submits Video File (MP4, WebM, MOV, AVI)
UploadMod -[#0052cc]-> RESTVideoRes : Polls Processing Progress (0% to 100%)
UploadMod -[#0052cc]-> RESTVideoStream : Plays Processed Video via HTTP Range Requests
UploadMod -[#0052cc]-> SubExporter : Downloads Transcripts (.srt, .vtt, .json, .txt)

PracticeMod -[#0052cc]-> RESTFrame : Sends Single Camera Frame for Practice Verification
PracticeMod -[#111111]-> VisualizerEng : Renders Anatomical Target Handshape & Scoring
DictMod -[#0052cc]-> DictAPI : Requests ASL & ISL Vocabulary Data
DictMod -[#111111]-> VisualizerEng : Renders Mini Card Skeletons & Modal Inspector

CustomMod -[#0052cc]-> CustomAPI : Submits Recorded Landmark Vector Samples
CustomMod -[#0052cc]-> CustomAPI : Fetches List of Registered Gestures

' Backend & REST Dispatch
AppMain -[#ff991f]-> StorageStatic : Serves Frontend Single Page Application
WSFeed -[#00875a]-> MPExtractor : Decodes Binary Frame Bytes
RESTFrame -[#00875a]-> MPExtractor : Decodes Base64 Frame Image

RESTUpload -[#ff991f]-> StorageUploads : Saves Ingested Video File
RESTUpload -[#00875a]-> VidProc : Spawns Background Video Processing Thread
RESTVideoStream -[#ff991f]-> StorageUploads : Streams Video File Content
CustomAPI -[#00875a]-> CustTrainer : Records / Deletes Gesture Vectors
CustTrainer -[#ff991f]-> StorageCustom : Serializes Custom Samples JSON
DictAPI -[#00875a]-> MLLabels : Reads Canonical Class Definitions

' Engine Internal Flow
VidProc -[#6554c0]-> MPExtractor : Frame-by-Frame Tracking Pipeline
VidProc -[#6554c0]-> FeatEng : Extracts Invariant Features Per Frame
VidProc -[#6554c0]-> ASLClass : Evaluates Static Signs Per Frame
VidProc -[#6554c0]-> TempTracker : Tracks Dynamic Inflections Across Frames
VidProc -[#6554c0]-> SubExporter : Compiles Timestamped Translation Segments

MPExtractor -[#6554c0]-> FeatEng : 21 or 42 3D Landmark Points & Handedness
FeatEng -[#6554c0]-> ASLClass : 109-dim (ASL) / 228-dim (ISL) Invariant Features
FeatEng -[#6554c0]-> TempTracker : Real-Time Wrist & Fingertip Trajectories
FeatEng -[#6554c0]-> DynamicLSTM : Fixed-Length Sequence Landmark Vectors
FeatEng -[#6554c0]-> CustTrainer : Feature Vectors for k-NN Evaluation

ASLClass -[#6554c0]-> StabFilter : Static Frame Prediction & Confidence Score
TempTracker -[#6554c0]-> StabFilter : Dynamic Gesture Prediction & Cooldown State
DynamicLSTM -[#6554c0]-> StabFilter : Sequence Gesture Predictions
CustTrainer -[#6554c0]-> StabFilter : Custom Gesture Prediction & Distance Score

' NLP Integration & Frontend Speech Output
StabFilter -[#00875a]-> TokenContract : Emits Validated Token(text, conf, type, lang, ts)
TokenContract -[#00875a]-> TokenBuffer : Pushes Stable Token into Rolling Queue
TokenBuffer -[#00875a]-> SentenceProc : Provides Sequence of Contextual Tokens
SentenceProc -[#0052cc]-> WSFeed : Returns Natural Language Sentence Translation
StabFilter -[#0052cc]-> WSFeed : Returns Real-Time Frame HUD Landmark Payload
StabFilter -[#0052cc]-> RESTFrame : Returns Immediate Single-Frame Classification

WSFeed -[#0052cc]-> SentenceComp : Delivers Live Tokens & Formed Sentence
SentenceComp -[#111111]-> CamMod : Renders Live Subtitle Overlays & History Log
SentenceComp -[#111111]-> TTSEngine : Triggers Spoken Audio via Web Speech API

' Machine Learning Foundation Flow
StorageModels ..[#ff991f]..> MLAudit : Loads asl_rf_model.joblib for Compatibility Audit
FeatEng -[#de350b]-> MLAudit : Validates 109-dim Feature Parity

MLLabels -[#de350b]-> MLPrep : Supplies Canonical 41 ASL & 44 ISL Class IDs
MLPrep -[#ff991f]-> StorageData : Exports Compressed .npz Splits & JSON Manifests
StorageData -[#ff991f]-> MLDataset : StaticSignDataset Ingests .npz Arrays
MLDataset -[#de350b]-> MLTrainEval : Feeds Batched PyTorch Tensors to Training Loops

FeatEng -[#de350b]-> MLModelASL : 109-dim Invariant Tensor Input
FeatEng -[#de350b]-> MLModelISL : 228-dim Bimanual Invariant Tensor Input
FeatEng -[#de350b]-> MLModelLSTM : Multi-Frame Sequential Tensor Input

MLTrainEval -[#de350b]-> MLModelASL : Optimizes StaticASL_MLP Parameters
MLTrainEval -[#de350b]-> MLModelISL : Optimizes StaticISL_MLP Parameters
MLTrainEval -[#de350b]-> MLModelLSTM : Optimizes Dynamic Sequence LSTM Parameters

MLModelASL ..[#ff991f]..> StorageModels : Persists asl_static_mlp.pt Checkpoint
MLModelISL ..[#ff991f]..> StorageModels : Persists isl_static_mlp.pt Checkpoint
MLModelLSTM ..[#ff991f]..> StorageModels : Persists dynamic_lstm.pt Checkpoint

StorageModels ..[#de350b]..> ASLClass : Loads Trained Static MLP Models for Live Inference
StorageModels ..[#de350b]..> DynamicLSTM : Loads Trained LSTM Model for Live Inference

@enduml
